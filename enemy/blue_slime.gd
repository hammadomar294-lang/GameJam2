class_name BlueSlime
extends CharacterBody2D
## ============================================================
## سكربت عدو "السلّايم الأزرق"
## ------------------------------------------------------------
## - يبقى واقفاً في مكانه الثابت دون أي حركة.
## - بمجرد تشغيل اللعبة يعزف أنيميشن السكون "blue idle" باستمرار.
## ============================================================

# مرجع لعقدة الأنيميشن (تعيين تلقائي عبر @onready).
@onready var animated_sprite: AnimatedSprite2D = $AnimatedSprite2D


# يُستدعى عند دخول العقدة إلى المشهد لأول مرة.
func _ready() -> void:
	# تشغيل أنيميشن السكون بشكل مستمر (حلقي لأن "blue idle" loop = true).
	animated_sprite.play("blue idle")
